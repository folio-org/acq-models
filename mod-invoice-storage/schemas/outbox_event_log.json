{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "An transactional outbox event log",
  "type": "object",
  "properties": {
    "eventId": {
      "description": "The unique id of the event id",
      "$ref": "../../common/schemas/uuid.json"
    },
    "entityType": {
      "description": "Entity type of the event",
      "type": "string",
      "enum": [
        "Invoice",
        "InvoiceLine"
      ]
    },
    "action": {
      "description": "Action for entity",
      "type": "string"
    },
    "payload": {
      "description": "Event payload to send to Kafka",
      "type": "string"
    },
    "originalPayload": {
      "description": "Pre-edit entity payload. Populated only for Edit actions.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "eventId",
    "entityType",
    "action",
    "payload"
  ]
}
