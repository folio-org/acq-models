{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Voucher audit event",
  "type": "object",
  "properties": {
    "id": {
      "description": "UUID of the event",
      "$ref": "../../common/schemas/uuid.json"
    },
    "action": {
      "description": "Action for voucher (Create or Edit)",
      "$ref": "event_action.json"
    },
    "voucherId": {
      "description": "UUID of the voucher",
      "$ref": "../../common/schemas/uuid.json"
    },
    "userId": {
      "description": "UUID of the user who performed the action",
      "$ref": "../../common/schemas/uuid.json"
    },
    "eventDate": {
      "description": "Date time when event triggered",
      "format": "date-time",
      "type": "string"
    },
    "actionDate": {
      "description": "Date time when voucher action occurred",
      "format": "date-time",
      "type": "string"
    },
    "voucherSnapshot": {
      "description": "Full snapshot of the voucher",
      "type": "object",
      "javaType": "org.folio.rest.jaxrs.model.Voucher"
    },
    "originalVoucherSnapshot": {
      "description": "Snapshot of the voucher prior to the edit. Populated only for Edit actions.",
      "type": "object",
      "javaType": "org.folio.rest.jaxrs.model.Voucher"
    }
  },
  "additionalProperties": false
}
