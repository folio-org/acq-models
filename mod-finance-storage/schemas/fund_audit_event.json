{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Fund audit event",
  "type": "object",
  "properties": {
    "id": {
      "description": "UUID of the event",
      "$ref": "../../common/schemas/uuid.json"
    },
    "action": {
      "description": "Action for fund (Create or Edit)",
      "$ref": "event_action.json"
    },
    "fundId": {
      "description": "UUID of the fund",
      "$ref": "../../common/schemas/uuid.json"
    },
    "userId": {
      "description": "UUID of the user who performed the action",
      "$ref": "../../common/schemas/uuid.json"
    },
    "eventDate": {
      "description": "Date time when event triggered",
      "format": "date-time",
      "type": "string"
    },
    "actionDate": {
      "description": "Date time when fund action occurred",
      "format": "date-time",
      "type": "string"
    },
    "fundSnapshot": {
      "description": "Full snapshot of the fund",
      "type": "object",
      "javaType": "org.folio.rest.jaxrs.model.Fund"
    },
    "originalFundSnapshot": {
      "description": "Snapshot of the fund prior to the edit. Populated only for Edit actions.",
      "type": "object",
      "javaType": "org.folio.rest.jaxrs.model.Fund"
    }
  },
  "additionalProperties": false
}
