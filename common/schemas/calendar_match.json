{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "A record whose date equals one of the target dates of a calendar-based intent",
  "type": "object",
  "javaType": "org.folio.rest.jaxrs.model.CalendarMatch",
  "properties": {
    "intent": {
      "description": "The calendar-based intent, e.g. InvoicePaymentDue",
      "type": "string"
    },
    "entityType": {
      "description": "Type of the matched record, e.g. invoice",
      "type": "string"
    },
    "recordId": {
      "description": "UUID of the matched record",
      "$ref": "uuid.json"
    },
    "targetDate": {
      "description": "The record's date, one of the rule's target dates (YYYY-MM-DD)",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "intent",
    "entityType",
    "recordId",
    "targetDate"
  ]
}
